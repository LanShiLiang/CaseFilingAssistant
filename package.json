{
  "name": "case-filing-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "powershell -ExecutionPolicy Bypass -File scripts/bootstrap.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File scripts/dev.ps1",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && powershell -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
    "test:web": "turbo run test --filter=@case-filing/web",
    "test:backend": "powershell -ExecutionPolicy Bypass -File scripts/test-backend.ps1",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File scripts/test-e2e.ps1",
    "build": "turbo run build",
    "contracts:generate": "powershell -ExecutionPolicy Bypass -File scripts/generate-contracts.ps1",
    "contracts:check": "powershell -ExecutionPolicy Bypass -File scripts/check-contracts.ps1",
    "artifact:audit": "powershell -ExecutionPolicy Bypass -File scripts/artifact-audit.ps1",
    "verify": "powershell -ExecutionPolicy Bypass -File scripts/verify.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "openapi-typescript": "7.13.0",
    "turbo": "2.10.8",
    "typescript": "6.0.3"
  }
}
